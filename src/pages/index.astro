---
import evidence from "../data/evidence.json";
import "../styles/global.css";

const exactBefore = (100 * evidence.overall.mermaid_passed) / evidence.overall.total;
const exactAfter = (100 * evidence.overall.digest_passed) / evidence.overall.total;
const exactLift = 100 * evidence.overall.absolute_effect;
const failureReduction =
  100 *
  ((evidence.overall.total - evidence.overall.mermaid_passed) -
    (evidence.overall.total - evidence.overall.digest_passed)) /
  (evidence.overall.total - evidence.overall.mermaid_passed);
const inputRatio = evidence.resources.input_tokens.digest / evidence.resources.input_tokens.mermaid;
const reasoningRatio =
  evidence.resources.reasoning_output_tokens.digest /
  evidence.resources.reasoning_output_tokens.mermaid;
const year = new Date().getUTCFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="graph2agent cut exact Mermaid-comprehension failures by 50.41% in one frozen paired benchmark. Core v0.2.1 and Action v0.3.0 are live; MCP v0.2.0 npm publication is pending."
    />
    <meta name="theme-color" content="#11130f" />
    <meta property="og:title" content="graph2agent — 50.41% fewer exact-comprehension failures" />
    <meta
      property="og:description"
      content="A deterministic Mermaid digest measured on 330 private contracts. Core v0.2.1 and Action v0.3.0 are live; MCP v0.2.0 npm publication is pending."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://graph2agent.github.io/" />
    <meta property="og:image" content="https://graph2agent.github.io/brand/logo.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="1024" />
    <meta
      property="og:image:alt"
      content="graph2agent flowchart nodes connected to an agent terminal"
    />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="graph2agent — 50.41% fewer exact-comprehension failures" />
    <meta
      name="twitter:description"
      content="A deterministic Mermaid digest measured on 330 private contracts. Core v0.2.1 and Action v0.3.0 are live; MCP v0.2.0 npm publication is pending."
    />
    <meta name="twitter:image" content="https://graph2agent.github.io/brand/logo.png" />
    <meta
      name="twitter:image:alt"
      content="graph2agent flowchart nodes connected to an agent terminal"
    />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-48x48.png" type="image/png" sizes="48x48" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href="https://graph2agent.github.io/" />
    <title>graph2agent — 50.41% fewer exact-comprehension failures</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header shell">
      <a class="brand" href="#top" aria-label="graph2agent home">
        <img class="brand-mark" src="/favicon.svg" alt="" width="38" height="38" />
        <span>graph2agent</span>
      </a>
      <nav aria-label="Primary navigation">
        <a href="#how">How it works</a>
        <a href="#evidence">Evidence</a>
        <a href="#limits">Limits</a>
        <a class="nav-cta" href="https://github.com/graph2agent/graph2agent">GitHub</a>
      </nav>
    </header>

    <main id="main">
      <section id="top" class="hero shell" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow"><span></span> measured on 330 frozen, paired contracts</p>
          <h1 id="hero-title">50.41% fewer failures.<br /><em>Give agents the graph.</em></h1>
          <p class="hero-lede">
            Mermaid plus graph2agent's frozen <code>standard</code> digest cut exact-comprehension
            failures from 121 to 60 in one benchmark. Compile the same deterministic context in
            <code>make generate</code> and keep repositories current with a merge gate or daily bot
            PR. MCP <code>v0.2.0</code> activates through one <code>npx</code> command after npm publication.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="#how">Get the commands</a>
            <a class="button button-secondary" href="#evidence">Audit the result <span aria-hidden="true">↓</span></a>
          </div>
          <ul class="hero-facts" aria-label="Benchmark characteristics">
            <li>61 digest-only wins</li>
            <li>0 Mermaid-only wins</li>
            <li>+18.48 percentage points</li>
          </ul>
        </div>

        <div class="hero-demo" aria-label="Markdown annotation example">
          <div class="demo-toolbar">
            <span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span>architecture.md</span>
            <span class="agent-chip">agent context on</span>
          </div>
          <pre class="code-mermaid"><code><span class="muted">```mermaid</span>
flowchart LR
  Client --&gt; Gateway
  Gateway --&gt; API
<span class="muted">```</span></code></pre>
          <div class="hidden-context">
            <p><span aria-hidden="true">◌</span> Hidden in rendered Markdown</p>
            <pre><code>&lt;!-- graph2agent:begin format=v1 …
`Client` sends R001 to `Gateway`.
`Gateway` sends R002 to `API`.
The graph is one directed chain.
Missing links are unspecified.
graph2agent:end --&gt;</code></pre>
          </div>
        </div>
      </section>

      <section class="signal-band" aria-label="Confirmatory benchmark headline">
        <div class="shell signal-grid">
          <p class="signal-number">+{exactLift.toFixed(2)}<span>pp</span></p>
          <p class="signal-copy">
            exact contract-comprehension lift in one frozen, paired benchmark of
            <strong>{evidence.overall.total} private contracts</strong>
          </p>
          <a href="#evidence">Read the evidence boundary <span aria-hidden="true">→</span></a>
        </div>
      </section>

      <section id="comparison" class="section shell" aria-labelledby="comparison-title">
        <div class="section-heading">
          <p class="kicker">The handoff problem</p>
          <h2 id="comparison-title">A picture for humans.<br />A contract for agents.</h2>
          <p>
            Mermaid is concise by design. graph2agent makes topology and interpretation limits
            explicit, so the next agent spends less effort reconstructing the graph.
          </p>
        </div>

        <div class="comparison-grid">
          <article class="comparison-card raw-card">
            <div class="card-label"><span>Input A</span> Mermaid only</div>
            <pre><code>flowchart TD
  request[Request] --&gt; auth&#123;Authorized?&#125;
  auth --&gt;|yes| api(API)
  auth --&gt;|no| reject[Reject]</code></pre>
            <div class="inference-list">
              <p>Agent must reconstruct:</p>
              <ul>
                <li>which node branches</li>
                <li>the two possible terminal paths</li>
                <li>what shape and arrows do—or do not—mean</li>
              </ul>
            </div>
          </article>

          <article class="comparison-card digest-card">
            <div class="card-label"><span>Input B</span> Mermaid + graph2agent</div>
            <pre><code>Elements
- `Request` is a rectangle.
- `Authorized?` is a decision-shaped element.

Explicit relationships
- `Request` points to `Authorized?`.
- `Authorized?` points to `API`, labeled “yes”.
- `Authorized?` points to `Reject`, labeled “no”.

Derived topology
- Branch candidate: `Authorized?`.
- Terminal nodes: `API` and `Reject`.

Interpretation limits
- Shape does not prove runtime decision semantics.</code></pre>
            <p class="made-explicit"><span aria-hidden="true">✓</span> Structure and limits are explicit</p>
          </article>
        </div>
        <p class="illustrative-note">Illustrative compilation example; the measured study is reported below.</p>
      </section>

      <section id="how" class="section section-dark" aria-labelledby="how-title">
        <div class="shell">
          <div class="section-heading inverse">
            <p class="kicker">One compiler, four launch surfaces</p>
            <h2 id="how-title">Generate once. Keep every consumer current.</h2>
            <p class="activation-note">
              Core <code>v0.2.1</code>, Action <code>v0.3.0</code>, Homebrew, and direct Debian downloads are public. MCP <code>v0.2.0</code> is prepared for npm publication; signed APT is staged but not live.
            </p>
          </div>
          <ol class="surface-grid">
            <li>
              <span class="step">01</span>
              <h3>Install, then generate</h3>
              <p>Install with Homebrew or download a verified <a href="https://github.com/graph2agent/graph2agent/releases/tag/v0.2.1">amd64 or arm64 Debian package</a>, then put the deterministic update after your existing generators. The signed APT repository is staged but not live.</p>
              <code>brew install graph2agent/tap/graph2agent<br />make generate</code>
            </li>
            <li>
              <span class="step">02</span>
              <h3>Plug-and-play MCP</h3>
              <p>The prepared npm umbrella package gives an MCP-capable agent the tool without a manual native download. This command becomes live when <code>v0.2.0</code> is published to npm.</p>
              <code>npx -y graph2agent-mcp@0.2.0</code>
            </li>
            <li>
              <span class="step">03</span>
              <h3>Block stale merges</h3>
              <p>Make a read-only <code>graph2agent check .</code> job required before a pull request can merge.</p>
              <code>uses: graph2agent/github-action/.github/workflows/check-markdown.yml@7c57998614ba579be55829423eaaa1262c35eff4<br />with:<br />&nbsp;&nbsp;graph2agent-version: v0.2.1</code>
            </li>
            <li>
              <span class="step">04</span>
              <h3>Let the bot maintain it</h3>
              <p>Run daily, change only generated Markdown context, and reuse one focused refresh PR until it merges.</p>
              <code>uses: graph2agent/github-action/.github/workflows/maintain-markdown.yml@7c57998614ba579be55829423eaaa1262c35eff4<br />with:<br />&nbsp;&nbsp;graph2agent-version: v0.2.1</code>
            </li>
          </ol>
        </div>
      </section>

      <section id="evidence" class="section shell" aria-labelledby="evidence-title">
        <div class="section-heading evidence-heading">
          <div>
            <p class="kicker">Measured, with the caveats attached</p>
            <h2 id="evidence-title">The digest helped on the frozen task set.</h2>
          </div>
          <p>
            The frozen paired result supports efficacy on this benchmark. It does not by
            itself prove broader model, task, or production generalization.
          </p>
        </div>

        <div class="metric-grid">
          <article>
            <p class="metric-label">Mermaid alone</p>
            <p class="metric-value">{exactBefore.toFixed(2)}%</p>
            <p>{evidence.overall.mermaid_passed} / {evidence.overall.total} exact</p>
          </article>
          <article class="metric-highlight">
            <p class="metric-label">Mermaid + standard digest</p>
            <p class="metric-value">{exactAfter.toFixed(2)}%</p>
            <p>{evidence.overall.digest_passed} / {evidence.overall.total} exact</p>
          </article>
          <article>
            <p class="metric-label">Relative failure reduction</p>
            <p class="metric-value">{failureReduction.toFixed(2)}%</p>
            <p>121 failures reduced to 60; this is a relative error metric</p>
          </article>
        </div>

        <figure class="evidence-chart">
          <img
            src="/evidence/confirmatory-overall-accuracy.svg"
            alt={`Exact contract-comprehension accuracy across ${evidence.overall.total} paired contracts: Mermaid alone passed ${evidence.overall.mermaid_passed}; Mermaid plus the standard digest passed ${evidence.overall.digest_passed}.`}
            width="960"
            height="600"
            loading="lazy"
          />
          <figcaption>
            Exact paired accuracy. Bootstrap 95% sensitivity interval for the lift:
            {(100 * evidence.overall.bootstrap_lower).toFixed(2)} to {(100 * evidence.overall.bootstrap_upper).toFixed(2)} percentage points.
          </figcaption>
        </figure>

        <div class="resource-strip" aria-label="Selected run resources">
          <p><strong>{((inputRatio - 1) * 100).toFixed(2)}%</strong><span>more input tokens</span></p>
          <p><strong>{((1 - reasoningRatio) * 100).toFixed(2)}%</strong><span>fewer reasoning-output tokens</span></p>
          <p><strong>Unavailable</strong><span>provider monetary cost</span></p>
          <p><strong>{evidence.verdict.promotion}</strong><span>exact release verdict</span></p>
        </div>
      </section>

      <section id="limits" class="section shell limits" aria-labelledby="limits-title">
        <div>
          <p class="kicker">What this does not establish</p>
          <h2 id="limits-title">Evidence is a boundary, not decoration.</h2>
        </div>
        <ul>
          <li>One frozen, generated contract benchmark is not every software-engineering task.</li>
          <li>The requested configuration was Codex CLI 0.146.1, gpt-5.6-sol, high reasoning; resolved backend identity was unavailable.</li>
          <li>Only the supported Mermaid subset and the frozen <code>standard</code> digest were tested in this confirmatory result.</li>
          <li>Monetary cost was missing from native traces, so it is unavailable—not zero.</li>
          <li>Some Markdown ingestion pipelines strip HTML comments; end-to-end agent integrations still require validation.</li>
        </ul>
      </section>

      <section class="final-cta shell" aria-labelledby="cta-title">
        <p class="kicker">Keep the diagram. Add the contract.</p>
        <h2 id="cta-title">Put the graph in every agent's path.</h2>
        <div>
          <a class="button button-primary" href="https://github.com/graph2agent/graph2agent">Open graph2agent</a>
          <code>brew install graph2agent/tap/graph2agent</code>
          <code>npm pending → npx -y graph2agent-mcp@0.2.0</code>
        </div>
      </section>
    </main>

    <footer class="site-footer shell">
      <p>© {year} graph2agent. Licensed under Apache-2.0.</p>
      <div>
        <a href="#evidence">Evidence</a>
        <a href="https://github.com/graph2agent/benchmarks">Benchmarks</a>
        <a href="https://github.com/graph2agent/mcp">MCP</a>
        <a href="/LICENSE.txt">License</a>
      </div>
    </footer>
  </body>
</html>
