---
import evidence from "../data/evidence.json";
import diagramExample from "../data/examples/request-routing.json";
import compiledDiagramText from "../data/examples/request-routing.interpreted-v3.txt?raw";
import diagramSource from "../data/examples/request-routing.mmd?raw";
import release from "../data/release.json";
import "../styles/global.css";

const exactBefore = (100 * evidence.overall.mermaid_passed) / evidence.overall.total;
const exactAfter = (100 * evidence.overall.digest_passed) / evidence.overall.total;
const exactLift = 100 * evidence.overall.absolute_effect;
const failureReduction =
  100 *
  ((evidence.overall.total - evidence.overall.mermaid_passed) -
    (evidence.overall.total - evidence.overall.digest_passed)) /
  (evidence.overall.total - evidence.overall.mermaid_passed);
const inputRatio = evidence.resources.input_tokens.digest / evidence.resources.input_tokens.mermaid;
const outputRatio = evidence.resources.output_tokens.digest / evidence.resources.output_tokens.mermaid;
const reasoningRatio =
  evidence.resources.reasoning_output_tokens.digest /
  evidence.resources.reasoning_output_tokens.mermaid;
const releaseVersion = release.version;
const npmVersion = releaseVersion.slice(1);
const actionWorkflowRef = release.action_workflow_ref;
const coreReleaseUrl = `https://github.com/graph2agent/graph2agent/releases/tag/${releaseVersion}`;
const mcpReleaseUrl = `https://github.com/graph2agent/mcp/releases/tag/${releaseVersion}`;
const markdownFenceOpen = "```mermaid\n";
const markdownFenceClose = "\n```";
const year = new Date().getUTCFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="graph2agent turns supported Mermaid diagrams into deterministic rich text that coding agents can follow. Measured: 50.41% fewer exact-comprehension failures in one frozen paired benchmark."
    />
    <meta name="theme-color" content="#11130f" />
    <meta property="og:title" content="graph2agent — Mermaid diagrams, explained for agents" />
    <meta
      property="og:description"
      content="Turn compact Mermaid into explicit, deterministic text for coding agents. Measured: 50.41% fewer exact-comprehension failures in one frozen paired benchmark."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://graph2agent.github.io/" />
    <meta property="og:image" content="https://graph2agent.github.io/brand/logo.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="1024" />
    <meta
      property="og:image:alt"
      content="graph2agent flowchart nodes connected to an agent terminal"
    />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="graph2agent — Mermaid diagrams, explained for agents" />
    <meta
      name="twitter:description"
      content="Turn compact Mermaid into explicit, deterministic text for coding agents. Measured: 50.41% fewer exact-comprehension failures in one frozen paired benchmark."
    />
    <meta name="twitter:image" content="https://graph2agent.github.io/brand/logo.png" />
    <meta
      name="twitter:image:alt"
      content="graph2agent flowchart nodes connected to an agent terminal"
    />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-48x48.png" type="image/png" sizes="48x48" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href="https://graph2agent.github.io/" />
    <link rel="describedby" href="/llms.txt" />
    <title>graph2agent — Mermaid diagrams, explained for agents</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header shell">
      <a class="brand" href="#top" aria-label="graph2agent home">
        <img class="brand-mark" src="/favicon.svg" alt="" width="38" height="38" />
        <span>graph2agent</span>
      </a>
      <nav aria-label="Primary navigation">
        <a href="#comparison">What it does</a>
        <a href="#how">Install</a>
        <a href="#evidence">Evidence</a>
        <a class="nav-cta" href="https://github.com/graph2agent/graph2agent">GitHub</a>
      </nav>
    </header>

    <main id="main">
      <section id="top" class="hero shell" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow"><span></span> Mermaid in · graph2agent · explicit context out</p>
          <h1 id="hero-title">Mermaid diagrams,<br /><em>explained for agents.</em></h1>
          <p class="hero-lede">
            graph2agent turns Mermaid diagrams into explicit text for coding agents. Keep the
            diagram for people; add deterministic context that spells out the elements, connections,
            branches, order, topology, and what the notation does not prove. Humans can scan the
            picture visually; an agent receiving only Mermaid source must reconstruct those
            relationships from compact syntax.
          </p>
          <p class="hero-proof">
            In one frozen paired benchmark, adding that text cut exact-comprehension failures from
            121 to 60.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="#comparison">See the transformation</a>
            <a class="button button-secondary" href="#evidence">Audit the benchmark <span aria-hidden="true">↓</span></a>
          </div>
          <ul class="hero-facts" aria-label="Product characteristics">
            <li>Diagram stays for humans</li>
            <li>Rich text goes to agents</li>
            <li>Deterministic · no model call</li>
          </ul>
        </div>

        <div class="hero-demo" aria-label="Markdown annotation example">
          <div class="demo-toolbar">
            <span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span>diagram + generated context</span>
            <span class="agent-chip">agent context on</span>
          </div>
          <pre class="code-mermaid"><code><span class="muted">{markdownFenceOpen}</span>{diagramSource.trimEnd()}<span class="muted">{markdownFenceClose}</span></code></pre>
          <figure
            class="diagram-render hero-diagram-render"
            data-source-sha256={diagramExample.source_sha256}
          >
            <img
              src={diagramExample.rendered_svg}
              alt={diagramExample.rendered_alt}
              width={diagramExample.rendered_width}
              height={diagramExample.rendered_height}
            />
            <figcaption>Rendered Mermaid · same source, compiled for people</figcaption>
          </figure>
          <div class="hidden-context">
            <p>
              <span aria-hidden="true">◌</span> Exact {diagramExample.narrative_profile} agent
              context · {releaseVersion}
            </p>
            <pre><code>{compiledDiagramText.trimEnd()}</code></pre>
          </div>
        </div>
      </section>

      <section id="comparison" class="section shell" aria-labelledby="comparison-title">
        <div class="section-heading">
          <p class="kicker">Why agents need the text</p>
          <h2 id="comparison-title">Humans see the picture.<br />Agents need the structure spelled out.</h2>
          <p>
            Mermaid compresses many relationships into a few lines. As diagrams gain branches,
            loops, and participants, graph2agent expands the authored structure into explicit text
            while preserving the original diagram.
          </p>
        </div>

        <div class="comparison-grid">
          <article class="comparison-card raw-card">
            <div class="card-label"><span>Input A</span> Mermaid only</div>
            <pre class="comparison-source"><code>{diagramSource.trimEnd()}</code></pre>
            <figure
              class="diagram-render comparison-diagram-render"
              data-source-sha256={diagramExample.source_sha256}
            >
              <img
                src={diagramExample.rendered_svg}
                alt={diagramExample.rendered_alt}
                width={diagramExample.rendered_width}
                height={diagramExample.rendered_height}
                loading="lazy"
              />
              <figcaption>Rendered Mermaid · the picture humans scan</figcaption>
            </figure>
            <div class="inference-list">
              <p>Agent must reconstruct:</p>
              <ul>
                <li>which node branches</li>
                <li>the two possible terminal paths</li>
                <li>what shape and arrows do—or do not—mean</li>
              </ul>
            </div>
          </article>

          <article class="comparison-card digest-card">
            <div class="card-label">
              <span>Input B</span> Mermaid + graph2agent {diagramExample.narrative_profile}
            </div>
            <pre class="compiled-context"><code>{compiledDiagramText.trimEnd()}</code></pre>
            <p class="made-explicit"><span aria-hidden="true">✓</span> Structure and limits are explicit</p>
          </article>
        </div>
        <p class="illustrative-note">Illustrative compilation example; the measured study is reported below.</p>
      </section>

      <section class="signal-band" aria-label="Confirmatory benchmark headline">
        <div class="shell signal-grid">
          <p class="signal-number">+{exactLift.toFixed(2)}<span>pp</span></p>
          <p class="signal-copy">
            exact contract-comprehension lift in one frozen, paired benchmark of
            <strong>{evidence.overall.total} private contracts</strong>
          </p>
          <a href="#evidence">Read the evidence boundary <span aria-hidden="true">→</span></a>
        </div>
      </section>

      <section id="how" class="section section-dark" aria-labelledby="how-title">
        <div class="shell">
          <div class="section-heading inverse">
            <p class="kicker">One compiler, four launch surfaces</p>
            <h2 id="how-title">Generate once. Keep every consumer current.</h2>
            <p class="activation-note">
              Core <code>{releaseVersion}</code>, Action <code>{releaseVersion}</code>, Homebrew,
              and direct Debian downloads are public. MCP <code>{releaseVersion}</code> is live
              through npm on macOS and Linux; native Windows downloads are live on GitHub, while
              one-command npm activation on Windows is pending. The signed APT repository is
              staged but not live.
            </p>
          </div>
          <ol class="surface-grid">
            <li>
              <span class="step">01</span>
              <h3>Paste one, or generate them all</h3>
              <p>Install with Homebrew or a verified <a href={coreReleaseUrl}>amd64 or arm64 Debian package</a>. Paste one diagram for rich text on stdout, or put the repository update after your existing generators.</p>
              <code>brew install graph2agent/tap/graph2agent<br />graph2agent describe --profile interpreted-v3 -<br />make generate</code>
            </li>
            <li>
              <span class="step">02</span>
              <h3>Plug-and-play MCP</h3>
              <p>On macOS and Linux, the live <a href="https://www.npmjs.com/package/graph2agent-mcp">npm package</a> gives an MCP-capable agent the tool without a manual native download. Windows users can use the verified native executables from the <a href={mcpReleaseUrl}>{releaseVersion} GitHub release</a>; one-command npm activation on Windows is pending.</p>
              <code>npx -y graph2agent-mcp@{npmVersion}</code>
            </li>
            <li>
              <span class="step">03</span>
              <h3>Block stale merges</h3>
              <p>Make a read-only <code>graph2agent check .</code> job required before a pull request can merge.</p>
              <code>uses: graph2agent/github-action/.github/workflows/check-markdown.yml@{actionWorkflowRef}<br />with:<br />&nbsp;&nbsp;graph2agent-version: {releaseVersion}</code>
            </li>
            <li>
              <span class="step">04</span>
              <h3>Let the bot maintain it</h3>
              <p>Run daily, change only generated Markdown context, and reuse one focused refresh PR until it merges.</p>
              <code>uses: graph2agent/github-action/.github/workflows/maintain-markdown.yml@{actionWorkflowRef}<br />with:<br />&nbsp;&nbsp;graph2agent-version: {releaseVersion}</code>
            </li>
          </ol>
        </div>
      </section>

      <section id="evidence" class="section shell" aria-labelledby="evidence-title">
        <div class="section-heading evidence-heading">
          <div>
            <p class="kicker">Measured, with the caveats attached</p>
            <h2 id="evidence-title">The digest helped on the frozen task set.</h2>
          </div>
          <p>
            The frozen paired result supports efficacy on this benchmark. It does not by
            itself prove broader model, task, or production generalization.
          </p>
        </div>

        <div class="metric-grid">
          <article>
            <p class="metric-label">Mermaid alone</p>
            <p class="metric-value">{exactBefore.toFixed(2)}%</p>
            <p>{evidence.overall.mermaid_passed} / {evidence.overall.total} exact</p>
          </article>
          <article class="metric-highlight">
            <p class="metric-label">Mermaid + standard digest</p>
            <p class="metric-value">{exactAfter.toFixed(2)}%</p>
            <p>{evidence.overall.digest_passed} / {evidence.overall.total} exact</p>
          </article>
          <article>
            <p class="metric-label">Relative failure reduction</p>
            <p class="metric-value">{failureReduction.toFixed(2)}%</p>
            <p>121 failures reduced to 60; this is a relative error metric</p>
          </article>
        </div>

        <figure class="evidence-chart">
          <img
            src="/evidence/confirmatory-overall-accuracy.svg"
            alt={`Exact contract-comprehension accuracy across ${evidence.overall.total} paired contracts: Mermaid alone passed ${evidence.overall.mermaid_passed}; Mermaid plus the standard digest passed ${evidence.overall.digest_passed}.`}
            width="960"
            height="600"
            loading="lazy"
          />
          <figcaption>
            Exact paired accuracy. Bootstrap 95% sensitivity interval for the lift:
            {(100 * evidence.overall.bootstrap_lower).toFixed(2)} to {(100 * evidence.overall.bootstrap_upper).toFixed(2)} percentage points.
          </figcaption>
        </figure>

        <p class="resource-caption">
          <strong>Observed aggregate token counts.</strong> Mermaid + graph2agent relative to
          Mermaid-only across the same {evidence.overall.total} paired cases.
        </p>
        <div class="resource-strip" aria-label="Observed aggregate token counts">
          <p><strong>{((inputRatio - 1) * 100).toFixed(2)}%</strong><span>more input tokens</span></p>
          <p><strong>{((1 - outputRatio) * 100).toFixed(2)}%</strong><span>fewer output tokens</span></p>
          <p><strong>{((1 - reasoningRatio) * 100).toFixed(2)}%</strong><span>fewer reasoning-output tokens</span></p>
        </div>
      </section>

      <section id="limits" class="section shell limits" aria-labelledby="limits-title">
        <div>
          <p class="kicker">What this does not establish</p>
          <h2 id="limits-title">Evidence is a boundary, not decoration.</h2>
        </div>
        <ul>
          <li>One frozen, generated contract benchmark is not every software-engineering task.</li>
          <li>The requested configuration was Codex CLI 0.146.1, gpt-5.6-sol, high reasoning; resolved backend identity was unavailable.</li>
          <li>Only the supported Mermaid subset and the frozen <code>standard</code> digest were tested in this confirmatory result.</li>
          <li>Monetary cost was missing from native traces, so it is unavailable—not zero.</li>
          <li>Some Markdown ingestion pipelines strip HTML comments; end-to-end agent integrations still require validation.</li>
        </ul>
      </section>

      <section class="final-cta shell" aria-labelledby="cta-title">
        <p class="kicker">Keep the diagram. Add the explanation.</p>
        <h2 id="cta-title">Give every coding agent the text behind the graph.</h2>
        <div>
          <a class="button button-primary" href="https://github.com/graph2agent/graph2agent">Open graph2agent</a>
          <code>brew install graph2agent/tap/graph2agent</code>
          <code>npx -y graph2agent-mcp@{npmVersion}</code>
        </div>
      </section>
    </main>

    <footer class="site-footer shell">
      <p>© {year} graph2agent. Licensed under Apache-2.0.</p>
      <div>
        <a href="#evidence">Evidence</a>
        <a href="https://github.com/graph2agent/benchmarks">Benchmarks</a>
        <a href="https://github.com/graph2agent/mcp">MCP</a>
        <a href="/llms.txt">llms.txt</a>
        <a href="/LICENSE.txt">License</a>
      </div>
    </footer>
  </body>
</html>
